# linux-riscv64 target: cross-compiled with QEMU used only for the smoke test.
#
# There is no hosted riscv64 runner. Cross-compiling on an x86 runner is fast;
# running the result under QEMU is not, so emulation is limited to `--version`
# self-checks (TOOLS-REPO.md §2).

TARGET=linux-riscv64
GOOS=linux
GOARCH=riscv64

HOST=riscv64-linux-gnu
CC=riscv64-linux-gnu-gcc
CXX=riscv64-linux-gnu-g++
AR=riscv64-linux-gnu-ar
RANLIB=riscv64-linux-gnu-ranlib
STRIP=riscv64-linux-gnu-strip

# rv64gc is the baseline every riscv64 Linux distribution targets.
CFLAGS="-O2 -fPIC -static -march=rv64gc -mabi=lp64d"
CXXFLAGS="-O2 -fPIC -static -march=rv64gc -mabi=lp64d"
LDFLAGS="-static"

CMAKE_SYSTEM_NAME=Linux
CMAKE_SYSTEM_PROCESSOR=riscv64

CROSS_PREFIX=riscv64-linux-gnu-
