# linux-arm64 target: native build on GitHub's arm64 hosted runner.
#
# Public repositories get the arm64 runners for free with no minute limit, so
# this target builds natively instead of cross-compiling (TOOLS-REPO.md §2).

TARGET=linux-arm64
GOOS=linux
GOARCH=arm64

HOST=aarch64-linux-gnu
CC=gcc
CXX=g++
AR=ar
RANLIB=ranlib
STRIP=strip

CFLAGS="-O2 -fPIC -static"
CXXFLAGS="-O2 -fPIC -static"
LDFLAGS="-static"

CMAKE_SYSTEM_NAME=Linux
CMAKE_SYSTEM_PROCESSOR=aarch64

CROSS_PREFIX=
