# win-arm64 target: cross-compiled with llvm-mingw.
#
# Only llvm-mingw can produce win-arm64 binaries; GCC mingw-w64 has no arm64
# support (TOOLS-REPO.md §2). Some older C code with x86 inline assembly will
# not build here, which is why the smoke test matters.

TARGET=win-arm64
GOOS=windows
GOARCH=arm64

HOST=aarch64-w64-mingw32
CC=aarch64-w64-mingw32-gcc
CXX=aarch64-w64-mingw32-g++
AR=aarch64-w64-mingw32-ar
RANLIB=aarch64-w64-mingw32-ranlib
STRIP=aarch64-w64-mingw32-strip
WINDRES=aarch64-w64-mingw32-windres

CFLAGS="-O2 -fPIC -static"
CXXFLAGS="-O2 -fPIC -static"
LDFLAGS="-static"

CMAKE_SYSTEM_NAME=Windows
CMAKE_SYSTEM_PROCESSOR=aarch64

CROSS_PREFIX=aarch64-w64-mingw32-
EXE_SUFFIX=.exe
