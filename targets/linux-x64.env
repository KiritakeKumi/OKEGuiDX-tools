# linux-x64 target: fully static, musl-based.
#
# Sourced by scripts/build.sh. Every variable is exported to the recipe.
# See TOOLS-REPO.md §2 and §4.

TARGET=linux-x64
GOOS=linux
GOARCH=amd64

# Alpine's musl toolchain is used through the container image, so the compiler
# is the container's own gcc.
HOST=x86_64-alpine-linux-musl
CC=gcc
CXX=g++
AR=ar
RANLIB=ranlib
STRIP=strip

CFLAGS="-O2 -fPIC -static"
CXXFLAGS="-O2 -fPIC -static"
LDFLAGS="-static"

# Static linking needs these for CMake-based recipes.
CMAKE_SYSTEM_NAME=Linux
CMAKE_SYSTEM_PROCESSOR=x86_64

# The build runs inside a container, so no cross prefix is needed.
CROSS_PREFIX=
