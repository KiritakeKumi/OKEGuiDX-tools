# win-x64 target: cross-compiled with llvm-mingw.
#
# Both Windows targets build on a Linux runner with llvm-mingw, which covers
# x86_64 and aarch64 with one toolchain and produces binaries with no VC++
# runtime dependency (TOOLS-REPO.md §2). GCC mingw-w64 cannot target arm64.

TARGET=win-x64
GOOS=windows
GOARCH=amd64

HOST=x86_64-w64-mingw32
CC=x86_64-w64-mingw32-gcc
CXX=x86_64-w64-mingw32-g++
AR=x86_64-w64-mingw32-ar
RANLIB=x86_64-w64-mingw32-ranlib
STRIP=x86_64-w64-mingw32-strip
WINDRES=x86_64-w64-mingw32-windres

# -static pulls in the mingw runtime, so the result needs no DLLs next to it.
CFLAGS="-O2 -fPIC -static"
CXXFLAGS="-O2 -fPIC -static"
LDFLAGS="-static"

CMAKE_SYSTEM_NAME=Windows
CMAKE_SYSTEM_PROCESSOR=x86_64

CROSS_PREFIX=x86_64-w64-mingw32-
EXE_SUFFIX=.exe
